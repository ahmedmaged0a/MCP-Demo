{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "playwright.config.ts",
    "global-setup.ts",
    "global-teardown.ts",
    "scripts/**/*.ts",
    "test-data/**/*.ts",
    "tests/**/*.ts"
  ]
}
